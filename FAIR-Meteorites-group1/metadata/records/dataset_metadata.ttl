@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix ont: <https://w3id.org/FAIR-course-UT/2026/group01/ont#> .
@prefix prov: <http://www.w3.org/ns/prov#> .

<https://w3id.org/FAIR-course-UT/2026/group01/meta/dataset/nasa-meteorite-landings-witnessed-falls-fairified> a dcat:Dataset ;
    dct:title "NASA Meteorite Landings: Witnessed Falls (FAIRified)" ;
    dct:description "A curated subset of 1,107 witnessed meteorite falls from the NASA Open Data Portal, transformed into a validated RDF knowledge graph." ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:creator "Rishi Raghavendran", "Kavisha Shah" ;
    dct:issued "2026-10-18"^^xsd:date ;
    prov:wasDerivedFrom <https://data.nasa.gov/dataset/meteorite-landings> ;
    ont:observationType "Witnessed Fall" ;
    dcat:distribution <https://w3id.org/FAIR-course-UT/2026/group01/meta/distribution/meteorite-witnessed-falls-original-csv>, <https://w3id.org/FAIR-course-UT/2026/group01/meta/distribution/meteorite-witnessed-falls-fairified-rdf> .
